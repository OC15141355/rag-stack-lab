                    "additionalProperties": {
                      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  }
