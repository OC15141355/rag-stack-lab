                "required": [
                  "version"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "id": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "image_values": {
            "additionalProperties": {
              "enum": [
                "repo-image-version",
                "repository-tag"
              ]
            },
            "type": "object"
          },
          "kind": {
            "enum": [
              "helm",
              "helm-crds",
              "manifests",
              "image",
              "external"
