          "required": [
            "air_gapped",
            "internal_ranges",
            "ingress_namespace",
            "client_namespaces",
            "gpu_quota",
            "storage",
            "gateway"
          ],
          "type": "object"
        },
        "qa": {
          "additionalProperties": false,
          "properties": {
            "air_gapped": {
              "type": "boolean"
