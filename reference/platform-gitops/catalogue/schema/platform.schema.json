{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "helm",
                    "helm-crds"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "envs": {
                  "additionalProperties": false,
                  "properties": {
                    "dev": {
                      "required": [
                        "chart",
                        "version"
                      ]
                    },
                    "prod": {
                      "required": [
                        "chart",
                        "version"
                      ]
                    },
                    "qa": {
                      "required": [
                        "chart",
                        "version"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "helm"
                }
              }
            },
            "then": {
              "required": [
                "namespace",
                "crds"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "support_ends": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "review_by"
              ]
            }
          }
        ],
        "properties": {
          "crds": {
            "enum": [
              "include",
              "skip"
            ]
          },
          "envs": {
            "additionalProperties": false,
            "properties": {
              "dev": {
                "additionalProperties": false,
                "properties": {
                  "chart": {
                    "type": "string"
                  },
                  "images": {
                    "additionalProperties": {
                      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "version"
                ],
                "type": "object"
              },
              "prod": {
                "additionalProperties": false,
                "properties": {
                  "chart": {
                    "type": "string"
                  },
                  "images": {
                    "additionalProperties": {
                      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
