          "nvidia_branch": {
            "enum": [
              "infrastructure",
              "production",
              "ltsb",
              "feature",
              "none"
            ]
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "review_by": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "state": {
            "enum": [
              "adopted",
              "evaluating",
              "deprecated"
            ]
          },
          "support_ends": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
